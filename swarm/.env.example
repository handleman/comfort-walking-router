# Swarm harness env — copy to swarm/.env or repo-root .env (gitignored, ADR-006).
# Never commit values. Every SWARM_*_MODEL is REQUIRED (code has no hardcoded
# model ids; missing var = RuntimeError naming it).
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Prefixes route automatically: ollama/* → local Ollama (think:false forced),
# zen/* → OpenCode Zen gateway, anything else → OpenRouter.
# Verified working 2026-10-10 (free tiers churn — re-ping on failure):
#   planner/reviewer: openrouter/nvidia/nemotron-3-super-120b-a12b:free
#   reviewer alt:     zen/<live-free-chat-model> (space-bunny-free 404'd same day)
#   coder:            ollama/swarm-coder:latest (tuned image, make swarm-coder-image)
SWARM_PLANNER_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
SWARM_REVIEWER_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
SWARM_CODER_MODEL=ollama/swarm-coder:latest
SWARM_ZEN_FALLBACK_MODEL=zen/big-pickle
SWARM_ZEN_BASE_URL=https://opencode.ai/zen/v1
# Paid-model guard: any id without :free / -free / ollama/ raises unless BOTH
# SWARM_ALLOW_PAID=1 here AND allow_paid=True is passed in code.
SWARM_ALLOW_PAID=0
