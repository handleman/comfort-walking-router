# Swarm harness env — copy to .env (gitignored, ADR-006). Never commit values.
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Ordered fallback for planner/reviewer (must stay :free unless SWARM_ALLOW_PAID=1)
# Default is local Qwen: OpenRouter :free shared pool 429s under agentic-loop
# load (verified 2026-10-10). Set to a :free id to use cloud brains instead.
# Prefixes route automatically: ollama/* → local, zen/* → OpenCode Zen,
# openrouter/* or */*:free → OpenRouter. Verified working:
#   openrouter/nvidia/nemotron-3-super-120b-a12b:free, zen/space-bunny-free
SWARM_PLANNER_MODEL=ollama/qwen3.5:9b
SWARM_REVIEWER_MODEL=ollama/qwen3.5:9b
SWARM_CODER_MODEL=ollama/qwen3.5:9b
SWARM_ZEN_FALLBACK_MODEL=openai/muse-spark-1.3-contributor-free
SWARM_ZEN_BASE_URL=https://opencode.ai/zen/v1
SWARM_ALLOW_PAID=0
