# Swarm harness env — copy to .env in the repo root (gitignored, ADR-006).
# Required to run: the keys, the four models, SWARM_ALLOW_PAID, and the gate
# commands for your stack. Everything under "optional" shows its code default.
# Model routing and the paid guard: swarm/docs/setup.md.
# Paid guard is one switch: SWARM_ALLOW_PAID=1 allows paid ids (local and
# :free/-free ids never need it).

# --- required ---------------------------------------------------------------
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
MAPBOX_TOKEN=
# 057: Figma REST token (personal access token, backend-only, read access to
# the file). Present -> `hq design sync` uses REST; absent -> MCP OAuth
# (`hq figma auth`, token stored outside the repo). Never commit the value.
FIGMA_TOKEN=
# 005: Postgres for saved routes/prefs. Export it in the shell — app/db.py reads
# os.environ at import, it does not load this file. e2e forwards process.env.
# DATABASE_URL=postgresql://postgres:comfort@localhost:5432/comfort
SWARM_ALLOW_PAID=1
# Every role model must be present; every fallback must be a model the provider
# can serve (preflight checks the catalogue). This profile is OpenCode Go:
# cheap flash tiers for the bulk roles, the flagship reserved for escalation.
SWARM_PLANNER_MODEL=opencode-go/glm-5.3-flash
SWARM_PLANNER_FALLBACK_MODEL=opencode-go/mimo-v2.6-flash
SWARM_CODER_MODEL=opencode-go/glm-5.3-flash
SWARM_CODER_FALLBACK_MODEL=opencode-go/mimo-v2.6-flash
SWARM_REVIEWER_MODEL=opencode-go/mimo-v2.6-flash
SWARM_REVIEWER_FALLBACK_MODEL=opencode-go/qwen3.8-flash
SWARM_SENIOR_MODEL=opencode-go/deepseek-v4-pro
SWARM_SENIOR_FALLBACK_MODEL=opencode-go/kimi-k2.7-code
SWARM_VERIFIER_MODEL=opencode-go/qwen3.8-flash
SWARM_VERIFIER_FALLBACK_MODEL=opencode-go/mimo-v2.6-flash
# 042/043: the vision roles need an image-capable model (and a VL fallback).
SWARM_VISUAL_MODEL=opencode-go/hy4-flash-free
SWARM_VISUAL_FALLBACK_MODEL=opencode-go/claude-haiku-5-5
SWARM_ACCEPT_MODEL=opencode-go/hy4-flash-free
SWARM_ACCEPT_FALLBACK_MODEL=opencode-go/claude-haiku-5-5
SWARM_GATE_COMMANDS="pytest -q;ruff check .;mypy app tests;npm --prefix frontend run check;npm --prefix frontend run lint;npm --prefix frontend test -- --run"

# --- routing ----------------------------------------------------------------
# ollama/* local, zen/* OpenCode Zen, opencode-go/* OpenCode Go, else OpenRouter.
OLLAMA_BASE_URL=http://localhost:11434
SWARM_ZEN_BASE_URL=https://opencode.ai/zen/v1
# OpenCode Go (subscription): `OPENCODE_GO_API_KEY` from the console. Model ids
# are the bare ones (`opencode-go/glm-5.3-flash`, `opencode-go/qwen3.8-flash`).
#SWARM_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
#OPENCODE_GO_API_KEY=   # required by the opencode-go/* profile
SWARM_GO_BASE_URL=https://opencode.ai/inference/go/openai/v1
SWARM_LOCAL_FIRST=1
SWARM_LOCAL_CODER_MODEL=ollama/swarm-coder:latest
SWARM_LOCAL_FALLBACK_MODEL=opencode-go/glm-5.3-flash
# The role fallbacks above are spelled out per role; SWARM_<ROLE>_FALLBACK_MODEL
# overrides them. A role without one falls back to SWARM_LOCAL_FALLBACK_MODEL.
#SWARM_CONFLICT_MODEL=ollama/swarm-coder:latest
SWARM_CONFLICT_CREW=1

# Keep the host awake while a flow runs (macOS `caffeinate`; 0 disables).
# A sleeping laptop stalls a provider call and reads as a fake model timeout.
SWARM_KEEP_AWAKE=1

# --- budgets (0 disables a limit) -------------------------------------------
SWARM_MAX_TOKENS=2000000
SWARM_MAX_COST_USD=0.05
SWARM_MAX_RUNTIME_SECONDS=14400
SWARM_MAX_COST_PER_TASK=0.25
SWARM_MAX_SECONDS_PER_TASK=2400
SWARM_TASK_WALL_BUDGET=1800
SWARM_LLM_TIMEOUT_SECONDS=180
SWARM_LLM_FIX_TIMEOUT_SECONDS=180
SWARM_LLM_MAX_RETRIES=0
SWARM_OLLAMA_TIMEOUT_SECONDS=1800

# --- phases (1 = on; 0 restores the pre-017/019/026 behaviour) ---------------
SWARM_TRUST_QA_EVIDENCE=1
SWARM_SELF_CHECK=1
SWARM_SELF_CHECK_COMMANDS=
SWARM_STYLE_FIX=1
SWARM_STYLE_FIX_COMMAND="npm --prefix frontend run lint:fix; ruff check --fix ."
SWARM_STYLE_PRE_QA=1
SWARM_VERIFY=1
SWARM_VERIFY_READ_CHARS=60000
SWARM_DELTA_GUARD=1
SWARM_JUDGE_FAIL_CLOSED=1
SWARM_CORRECTION_GUARD=1
SWARM_QUOTA_BREAKER=1
SWARM_QUOTA_LIMIT=3
SWARM_E2E_EVIDENCE=1
SWARM_PREFLIGHT_FACTORIES=1

# --- commit path and hygiene ------------------------------------------------
#SWARM_MERGE_MODE=merge   # direct = commit on the current branch
#SWARM_BASE_BRANCH=
#SWARM_DELETE_MERGED_BRANCH=0
#SWARM_SCOPE=app/,frontend/,tests/,contracts/   # widen the coder scope
SWARM_RESUME_MAX_AGE_SECONDS=86400
SWARM_STASH_UNRELATED=1
SWARM_ARCHIVE_STASHES=1
SWARM_REVERT_OUT_OF_SCOPE=1
SWARM_SELF_HEAL=1

# --- context economics (020) ------------------------------------------------
SWARM_CONTEXT_COMPACT=1
SWARM_GATE_SPILL_CHARS=2000
SWARM_GATE_TAIL_CHARS=20000
SWARM_GATE_SELECT=1
SWARM_CODER_READ_CHARS=3000
SWARM_PROMPT_CACHE=1

# --- A/B experiments (off: the replay suites decide) ------------------------
SWARM_TESTS_FIRST=0
SWARM_CODER_ACS=0
SWARM_MAX_FIX_ROUNDS=3
SWARM_CODER_LOOSE=0
SWARM_PLAN_MAX_STEPS=8
SWARM_VERIFY_CONCURRENT=0
SWARM_VERIFY_LEAN=0
SWARM_LEAN_MAX_PATHS=4
SWARM_LEAN_MAX_LINES=200
SWARM_BENCH_MODELS=
SWARM_BENCH_CASES=
SWARM_REPLAY_CASES=
SWARM_REPLAY_OFF=0
SWARM_REPLAY_TIMEOUT=2400

# --- sandbox (opt-in Docker) ------------------------------------------------
#SWARM_SANDBOX_ALLOW_COMMIT=0
#SWARM_SANDBOX_SSH=0
#SWARM_SANDBOX_OLLAMA_URL=http://host.docker.internal:11434
