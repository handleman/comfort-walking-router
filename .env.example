# Swarm harness env — copy to .env in the repo root (gitignored, ADR-006).
# Never commit values. Every SWARM_*_MODEL is REQUIRED (code has no hardcoded
# model ids; missing var = RuntimeError naming it).
OPENROUTER_API_KEY=
OPENCODE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Prefixes route automatically: ollama/* → local Ollama (think:false forced),
# zen/* → OpenCode Zen gateway, anything else → OpenRouter.
#
# Verified 2026-11-08 with tool calls (free-first; ids churn — `make swarm-preflight`
# catches a dead id before the first LLM call):
#   planner  openrouter/nvidia/nemotron-3.5-super-vl:free   1M ctx, ~1s, tools OK
#   coder    ollama/swarm-coder:latest (Qwen3.5 9B, make swarm-coder-image)   $0, local
#   reviewer ollama/swarm-qa:latest    (same base, QA prompt)                 $0, local
#   senior   openrouter/nvidia/nemotron-3-ultra-550b-a55b:free  550B, tools OK
SWARM_PLANNER_MODEL=openrouter/nvidia/nemotron-3.5-super-vl:free
SWARM_CODER_MODEL=ollama/swarm-coder:latest
SWARM_REVIEWER_MODEL=ollama/swarm-qa:latest
SWARM_SENIOR_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free

# Zen gateway (used by `zen/...` model ids, e.g. the paid coder fallback).
# Optional: the built-in default is this exact URL — set it only to point at a
# different gateway. base_url must stop at /v1 (the SDK appends /chat/completions).
# Zen is paid: it needs OPENCODE_API_KEY and SWARM_ALLOW_PAID=1.
SWARM_ZEN_BASE_URL=https://opencode.ai/zen/v1

# Local-only alternative (no keys, slowest): `make swarm-local` does this for you.
#   SWARM_PLANNER_MODEL=ollama/swarm-coder:latest
#   SWARM_REVIEWER_MODEL=ollama/swarm-qa:latest

# Fallback models after a quota/429 or an unreachable provider, per role.
# <ROLE> = PLANNER|CODER|REVIEWER|SENIOR. Every role falls back to
# SWARM_LOCAL_FALLBACK_MODEL (default ollama/swarm-coder:latest); a per-role
# SWARM_<ROLE>_FALLBACK_MODEL wins. SENIOR tries zen/glm-5.3-flash first when
# SWARM_ALLOW_PAID=1, otherwise it also lands on the local model.
# SWARM_PLANNER_FALLBACK_MODEL=ollama/swarm-coder:latest
# SWARM_SENIOR_FALLBACK_MODEL=zen/glm-5.3-flash

# Conflict resolver crews (016): one when a --no-ff merge conflicts, one when a
# `git stash apply` conflicts (parked work re-applied on the newer tree). Both
# are accepted only if no marker remains, only conflicted files were edited, and
# every gate is green; otherwise merge_failed / the current worktree is kept.
SWARM_CONFLICT_CREW=1
# Defaults to SWARM_CODER_MODEL; a local/cheap model also works here.
# SWARM_CONFLICT_MODEL=ollama/swarm-coder:latest

# Per-run budgets (012 T14): 0 disables a limit. Exceeding one stops the pilot
# with status=budget_exhausted. Free/local models keep cost at $0.
SWARM_MAX_TOKENS=2000000
SWARM_MAX_COST_USD=0.05
SWARM_MAX_RUNTIME_SECONDS=14400

# Commit path (012 T18). Default is branch-per-task + --no-ff merge into the base.
# SWARM_MERGE_MODE=merge          # direct = commit straight to the current branch
# SWARM_BASE_BRANCH=              # default: the branch checked out at commit time
# SWARM_DELETE_MERGED_BRANCH=0    # keep swarm/<spec>-<task> branches as audit records

# Crash checkpoints (013): resume a killed run only from a recent checkpoint.
SWARM_RESUME_MAX_AGE_SECONDS=86400

# Container sandbox (swarm/sandbox.sh, 012 T17): the repo is the only writable
# mount; .env is masked read-only. Needs a Docker daemon — macOS: `colima start`.
# SWARM_SANDBOX_ALLOW_COMMIT=0    # 1 = commit inside the container (needs credentials)
# SWARM_SANDBOX_SSH=0             # 1 = mount ~/.ssh read-only (opt-in)
# SWARM_SANDBOX_OLLAMA_URL=http://host.docker.internal:11434

# Paid-model guard: any id without :free / -free / ollama/ raises unless BOTH
# SWARM_ALLOW_PAID=1 here AND allow_paid=True is passed in code.
SWARM_ALLOW_PAID=0
MAPBOX_TOKEN=
# Project gate commands, semicolon or newline separated (harness is stack-agnostic).
# Replace these for another project; the flow and reviewer use this list.
SWARM_GATE_COMMANDS="pytest -q;ruff check .;mypy app tests;npm --prefix frontend run check;npm --prefix frontend run lint;npm --prefix frontend test -- --run"
# Style-only gate failures (Prettier/ESLint) are repaired by the harness
# before a coder round: set the project's formatter command here.
SWARM_STYLE_FIX=1
SWARM_STYLE_FIX_COMMAND="npm --prefix frontend run lint:fix"
# 017: the coder checks types and lint before QA sees the work. The harness
# runs the static subset of the gate commands (type checker + linter, never
# the test suites) and hands a red check back to the coder.
SWARM_SELF_CHECK=1
# Optional: the project's own static checks (semicolon separated). Empty means
# "derive the static subset of SWARM_GATE_COMMANDS".
SWARM_SELF_CHECK_COMMANDS=
# 019: the scenario verifier runs between the self-check and QA, sees the brief,
# the referenced ACs, the plan lines, the FULL content of every delta file and a
# static import/imported-by view, then hands the loop a correction plan when the
# implementation does not do what the brief says. It never writes, never runs a
# gate and never decides green. 0 disables it.
SWARM_VERIFY=1
# Whole-file read cap for the verifier (the coder keeps the 3000-char read).
SWARM_VERIFY_READ_CHARS=60000
# Defaults to SWARM_SENIOR_MODEL (free, tool-capable); set to give it its own.
# SWARM_VERIFIER_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free
# SWARM_VERIFIER_FALLBACK_MODEL=ollama/swarm-coder:latest
# Free cloud fallback used only when the local QA model returns no PASS/BLOCKED.

# 015: QA is the only gate executor; the flow reads harness-recorded evidence.
SWARM_TRUST_QA_EVIDENCE=1
# Paid coder for non-trivial steps; local only for mechanical ones.
SWARM_LOCAL_FIRST=1
SWARM_LOCAL_CODER_MODEL=ollama/swarm-coder:latest
# Shared fallback for every role when its cloud provider is unreachable.
SWARM_LOCAL_FALLBACK_MODEL=ollama/swarm-coder:latest
# Per-task ceilings (independent of the run budget) and hygiene.
SWARM_MAX_COST_PER_TASK=0.15
SWARM_MAX_SECONDS_PER_TASK=1800
SWARM_STASH_UNRELATED=1
# Orphaned `swarm-*` stashes are preserved as refs/swarm/archive/* and indexed in
# swarm/runs/orphan_stashes.json, then dropped; 0 = leave the stack untouched.
SWARM_ARCHIVE_STASHES=1
SWARM_REVERT_OUT_OF_SCOPE=1
SWARM_SELF_HEAL=1

# LLM transport: the harness owns retries (backoff + fallback models), so the SDK
# does not multiply the wait on a dead endpoint; 120s fits cloud + local models.
SWARM_LLM_TIMEOUT_SECONDS=180
SWARM_LLM_MAX_RETRIES=0
# Local models can legitimately take many minutes at 64k context; 30 min bounds a
# stuck call without cutting a real generation (300 s was hit twice on 2026-11-10).
SWARM_OLLAMA_TIMEOUT_SECONDS=1800

# 020: context economics. Compaction writes full step outputs to
# <run>/step_outputs/ and failing gate tails to <run>/gate_logs/, and gives the
# prompt a bounded digest plus the key `file:line: message` lines. 0 restores
# the 019 behaviour (full concatenation, tails in the report).
SWARM_CONTEXT_COMPACT=1
# A failing gate tail longer than this is spilled to gate_logs/ (chars).
SWARM_GATE_SPILL_CHARS=2000
# What shell_log.jsonl keeps per gate execution, and the source the report's
# key lines are extracted from. Disk, not prompt; the report tail stays 4k.
SWARM_GATE_TAIL_CHARS=20000
