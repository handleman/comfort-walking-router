{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RouteResponse",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable identifier derived from the query"
    },
    "name": {
      "type": "string",
      "description": "Name of the route"
    },
    "description": {
      "type": "string",
      "description": "Description of the route"
    },
    "waypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lat": {"type": "number"},
          "lng": {"type": "number"}
        },
        "required": ["lat", "lng"]
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "archived"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "comfort_score": {
      "type": "number"
    },
    "explanation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "geometry": {
      "$ref": "#/$defs/LineString",
      "description": "Route geometry per ADR-005 (GeoJSON, Leaflet-native)"
    },
    "distance_m": {
      "type": "number",
      "minimum": 0
    },
    "duration_s": {
      "type": "number",
      "minimum": 0
    },
    "applied_preference": {
      "type": "string",
      "description": "Preference actually applied to this route"
    },
    "preference_source": {
      "type": "string",
      "enum": ["auto", "manual"],
      "description": "Whether the applied preference was auto-selected or manually requested"
    },
    "weather": {
      "type": "object",
      "description": "Weather conditions used for scoring"
    }
  },
  "required": [
    "id",
    "name",
    "waypoints",
    "status",
    "timestamp",
    "geometry",
    "distance_m",
    "duration_s",
    "applied_preference",
    "preference_source",
    "weather"
  ],
  "$defs": {
    "RouteRequest": {
      "type": "object",
      "properties": {
        "start": {"type": "string", "minLength": 1},
        "end": {"type": "string", "minLength": 1},
        "preference": {"enum": ["hot", "cloudy", null], "default": null},
        "prefer_lit": {"type": "boolean", "default": false},
        "avoid_traffic": {"type": "boolean", "default": false}
      },
      "required": ["start", "end"]
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      },
      "required": ["code", "message"]
    },
    "LineString": {
      "type": "object",
      "properties": {
        "type": {"const": "LineString"},
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {"type": "number"},
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": ["type", "coordinates"]
    }
  }
}
