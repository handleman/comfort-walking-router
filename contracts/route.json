{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RouteResponse",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the route"
    },
    "name": {
      "type": "string",
      "description": "Name of the route"
    },
    "description": {
      "type": "string",
      "description": "Description of the route"
    },
    "waypoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lat": {"type": "number"},
          "lng": {"type": "number"}
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["active", "inactive", "archived"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["id", "name", "waypoints", "status", "timestamp"]
}