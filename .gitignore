# Secrets — ADR-006 env-only (never commit values; commit *.example only)
.env
.env.*
!.env.example
*.pem
*.key

# Python — backend, swarm harness (venv, caches, test/coverage)
.venv
.venv/
venv/
harness/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.uv/

# Node / Svelte / Vite — frontend/
node_modules/
frontend/node_modules
frontend/node_modules/
frontend/dist/
frontend/build/
.svelte-kit/
frontend/.svelte-kit/
vite.config.*.timestamp-*.mjs
frontend/test-results/
frontend/playwright-report/

# Figma design cache (057/041): local and disposable; `hq design sync`
# rebuilds it from the file key + token. Never commit the IR, renders or lock.
designs/

# Data — SQLite/OSM cache (ADR-004), swarm run traces
*.db
*.sqlite
*.sqlite-journal
*.osm
*.pbf
harness/runs/
harness/*.log

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo

swarm/bench/replay_last.json

# Playwright artifacts (the suite is a gate now; do not attribute them to a run)
test-results/
playwright-report/
cache/
